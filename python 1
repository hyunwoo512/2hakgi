import requests
import os

def read_api_key():
    """mykey.txt 파일에서 API 키를 읽어옵니다."""
    try:
        with open("mykey.txt", "r", encoding="utf-8") as f:
            return f.read().strip()
    except FileNotFoundError:
        print("오류: mykey.txt 파일이 없습니다. 파일을 생성하고 API 키를 넣어주세요.")
        return None

def analyze_match_history(data_text, api_key):
    """LLM API를 호출하여 게임 전적 데이터를 분석합니다."""
    url = "https://api.mindlogic.ai/v1/chat/completions" 
    
    headers = {
        "Content-Type": "application/json",
        "Authorization": f"Bearer {api_key}"
    }
    
    prompt = f"""
    당신이 입력한 게임 전적 데이터를 분석하여 다음 3가지 항목으로 피드백을 제공합니다:
    
    1. 플레이 요약 (KDA 요약, 주요 지표 특징)
    2. 강점 및 약점 분석 (잘한 점과 아쉬운 점)
    3. 다음 게임 승리를 위한 구체적인 개선 팁 및 연습 방향

    전적 데이터:
    {data_text}
    """

    payload = {
        "model": "사용할_모델명_입력", # 요금제 문서에 있는 실제 모델명(예: llama-3 등)으로 변경하세요
        "messages": [{"role": "user", "content": prompt}],
        "temperature": 0.6
    }

    try:
        response = requests.post(url, headers=headers, json=payload)
        response.raise_for_status()
        result = response.json()
        return result['choices'][0]['message']['content']
    except Exception as e:
        return f"API 호출 중 오류가 발생했습니다: {e}"

def main():
    print("===  게임 전적 분석 AI 코치 ===")
    api_key = read_api_key()
    if not api_key:
        return

    print("최근 게임 전적 데이터를 텍스트로 복사하여 붙여넣으세요.")
    print("(입력을 모두 마쳤다면 비어있는 줄에서 '엔터'를 한 번 더 누르세요):")
    
    lines = []
    while True:
        line = input()
        if line == "":
            break
        lines.append(line)
    
    user_data = "\n".join(lines)
    
    if user_data.strip():
        print("\n[AI 코치가 전적을 분석 중입니다... 잠시만 기다려주세요]\n")
        
        analysis_result = analyze_match_history(user_data, api_key)
        
        print("===  코칭 결과 ===")
        print(analysis_result)
        print("====================")
    else:
        print("입력된 전적 데이터가 없습니다.")

if __name__ == "__main__":
    main()
